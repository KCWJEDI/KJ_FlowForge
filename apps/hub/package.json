{
  "name": "local-unity-workflow-hub",
  "version": "0.3.41",
  "private": true,
  "description": "Local Electron hub for Unity, Discord, Notion, and GitHub workflows",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "start": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@notionhq/client": "^2.2.15",
    "@octokit/rest": "^21.1.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.18"
  },
  "build": {
    "appId": "com.localworkflow.unity-workflow-hub",
    "productName": "KJ FlowForge",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KJ-FlowForge-${version}-${arch}.exe"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
